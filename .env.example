# Set a long random value. Used for the author dashboard login.
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-32-random-characters

# Optional but required for durable posts on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Your inbound email provider should POST to /api/email/inbound with this token.
EMAIL_WEBHOOK_SECRET=replace-with-a-different-long-secret
AUTHOR_EMAIL=you@example.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Added automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
